# Never in the image: your machines, keys, results and signing key live in data/.
data/
.env
.env.*
.npmrc
*.pem
*.key

# Rebuilt inside the image.
**/node_modules/
**/dist/

# Not needed to build or run.
.git/
.github/
**/test/
coverage/
# The tests and their stand-in servers: only their package.json, which npm ci needs.
e2e/*
!e2e/package.json
test-servers/*
!test-servers/package.json
docs/
fixtures/
*.log
*.tmp
.DS_Store
.vscode/
.idea/
Dockerfile
docker-compose*.yml
.dockerignore
smoke/
