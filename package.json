{
  "name": "model-duel",
  "version": "0.1.0",
  "private": true,
  "description": "Benchmark local AI models across machines that run Unsloth Studio.",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "workspaces": [
    "shared",
    "server",
    "client",
    "mock",
    "agent",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names server,client --prefix-colors blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false server/src/index.ts --port 3001 --api-only",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run build:client && npm run build:node",
    "build:client": "vite build --config client/vite.config.ts",
    "build:node": "tsx scripts/build-node.ts",
    "start": "node server/dist/index.js",
    "demo": "npm run build && tsx scripts/demo.ts",
    "mock": "tsx mock/src/index.ts",
    "agent": "tsx agent/src/index.ts",
    "record:probe": "tsx scripts/record-probe.ts",
    "typecheck": "tsc -p shared && tsc -p shared/test && tsc -p server && tsc -p mock && tsc -p agent && tsc -p client && tsc -p client/tsconfig.node.json && tsc -p e2e && tsc -p scripts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test -c e2e/playwright.config.ts",
    "record": "tsx scripts/record-stream.ts",
    "result-schema": "tsx scripts/result-schema.ts",
    "verify-result": "tsx scripts/verify-result.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
